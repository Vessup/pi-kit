{
	"name": "@vessup/pi-kit",
	"version": "0.1.0",
	"private": true,
	"description": "Reusable Pi coding agent extensions",
	"type": "module",
	"packageManager": "bun@1.3.10",
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"scripts": {
		"build": "bun run web:build",
		"check": "tsc --noEmit && tsc -p web/server/tsconfig.json --noEmit && tsc -p web/client/tsconfig.json --noEmit",
		"postinstall": "bun run web:build",
		"test": "bun test",
		"web:build": "vite build --config web/vite.config.ts",
		"web:dev": "vite --config web/vite.config.ts",
		"web:server": "bun run web/server/index.ts"
	},
	"pi": {
		"extensions": [
			"./extensions/session-footer.ts",
			"./extensions/pr-footer.ts",
			"./extensions/terminal-output.ts",
			"./extensions/subagents.ts",
			"./extensions/worktree.ts",
			"./extensions/web-sessions.ts",
			"./extensions/delete-session.ts"
		],
		"prompts": [
			"./prompts/address-pr.md"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@tailwindcss/vite": "4.1.18",
		"@types/bun": "1.3.10",
		"@types/node": "24.12.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.4",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "0.563.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.4.0",
		"tailwindcss": "4.1.18",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vite": "7.3.6"
	},
	"license": "MIT",
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@radix-ui/react-tooltip": "1.2.8",
		"diff": "8.0.3",
		"highlight.js": "11.11.1",
		"proper-lockfile": "4.1.2"
	}
}
